APP_NAME="Drive Phangan"
APP_ENV=production
APP_KEY="CHANGE_ME_GENERATED_APP_KEY"
APP_DEBUG=false
APP_URL=https://admin.example.com
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

TRUSTED_PROXIES=
SECURITY_CSP_ENABLED=true
SECURITY_CSP_UPGRADE_INSECURE_REQUESTS=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=drive_phangan
DB_USERNAME=drive_phangan_app
DB_PASSWORD="CHANGE_ME_DATABASE_PASSWORD"
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=admin.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=drive-phangan:

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST="CHANGE_ME_SMTP_HOST"
MAIL_PORT=587
MAIL_USERNAME="CHANGE_ME_SMTP_USERNAME"
MAIL_PASSWORD="CHANGE_ME_SMTP_PASSWORD"
MAIL_FROM_ADDRESS="CHANGE_ME_FROM_EMAIL"
MAIL_FROM_NAME="${APP_NAME}"

BUSINESS_TIMEZONE=Asia/Bangkok
BUSINESS_CURRENCY=THB
BOOKING_PENDING_TTL_HOURS=24
MANAGER_TELEGRAM_USERNAME="@CHANGE_ME"
BOOKING_CSV_DELIMITER=";"
VEHICLE_PHOTO_MAX_MB=8
CUSTOMER_DOCUMENT_MAX_MB=10
BOOKING_TERMS_VERSION="CHANGE_ME_APPROVED_TERMS_VERSION"

TELEGRAM_BOT_TOKEN="CHANGE_ME_TELEGRAM_BOT_TOKEN"
TELEGRAM_ADMIN_CHAT_ID="CHANGE_ME_NUMERIC_CHAT_ID"
TELEGRAM_ADMIN_LOCALE=ru
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_HTTP_TIMEOUT_SECONDS=10
TELEGRAM_CONNECT_TIMEOUT_SECONDS=5

NOTIFICATION_QUEUE=notifications
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RECIPIENT_BATCH_SIZE=50
NOTIFICATION_DELIVERY_BATCH_SIZE=25
NOTIFICATION_PROCESSING_STALE_MINUTES=10
NOTIFICATION_MONITOR_OVERDUE_MINUTES=15
NOTIFICATION_BACKOFF_SECONDS=60,300,900,3600,21600
NOTIFICATION_SENT_RETENTION_DAYS=90
NOTIFICATION_DISCARDED_RETENTION_DAYS=30
BOOKING_DAY_REMINDER_TIME=08:00
BOOKING_REMINDER_HORIZON_DAYS=45

BOT_API_AUTH_RATE_LIMIT_PER_MINUTE=30
BOT_API_SERVICE_RATE_LIMIT_PER_MINUTE=600
BOT_API_USER_RATE_LIMIT_PER_MINUTE=90
BOT_API_IDEMPOTENCY_TTL_HOURS=72
BOT_API_MAX_BATCH_SIZE=10
BOT_API_MAX_RENTAL_DAYS=366

SCHEDULER_HEARTBEAT_CACHE_KEY=operations:scheduler-heartbeat
SCHEDULER_HEARTBEAT_TTL_SECONDS=600
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_SCHEDULER=true

VITE_APP_NAME="${APP_NAME}"
