[Unit]
Description=Drive Phangan Laravel default queue worker
PartOf=drive-phangan.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=drive-phangan
Group=drive-phangan
WorkingDirectory=/srv/drive-phangan/current/backend
ExecStart=/usr/bin/php artisan queue:work redis --queue=default --sleep=1 --tries=3 --timeout=90
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=30s
TimeoutStopSec=100s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/drive-phangan/shared/backend/storage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=drive-phangan.target
