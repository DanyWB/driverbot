APP_NAME="Drive Phangan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Bangkok
TRUSTED_PROXIES=
SECURITY_CSP_ENABLED=false
SECURITY_CSP_UPGRADE_INSECURE_REQUESTS=true
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SCHEDULER_HEARTBEAT_CACHE_KEY=operations:scheduler-heartbeat
SCHEDULER_HEARTBEAT_TTL_SECONDS=600
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_SCHEDULER=false
BUSINESS_TIMEZONE=Asia/Bangkok
BUSINESS_CURRENCY=THB
BOOKING_PENDING_TTL_HOURS=24
MANAGER_TELEGRAM_USERNAME=
TELEGRAM_BOT_TOKEN=
# Public username without secrets, for example DrivePhangan_TestBot.
TELEGRAM_BOT_USERNAME=
# Bootstrap-only fallback used until the first database-backed admin binding.
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_LOCALE=ru
TELEGRAM_BINDING_CODE_TTL_MINUTES=10
TELEGRAM_BINDING_CODE_RETENTION_DAYS=7
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_HTTP_TIMEOUT_SECONDS=10
TELEGRAM_CONNECT_TIMEOUT_SECONDS=5
NOTIFICATION_QUEUE=notifications
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RECIPIENT_BATCH_SIZE=50
NOTIFICATION_DELIVERY_BATCH_SIZE=25
NOTIFICATION_PROCESSING_STALE_MINUTES=10
NOTIFICATION_MONITOR_OVERDUE_MINUTES=15
NOTIFICATION_BACKOFF_SECONDS=60,300,900,3600,21600
NOTIFICATION_SENT_RETENTION_DAYS=90
NOTIFICATION_DISCARDED_RETENTION_DAYS=30
BOOKING_DAY_REMINDER_TIME=08:00
BOOKING_REMINDER_HORIZON_DAYS=45
PRICING_WORKBOOK_PATH=
BOOKING_CSV_DELIMITER=";"
VEHICLE_PHOTO_MAX_MB=8
CUSTOMER_DOCUMENT_MAX_MB=10
BOOKING_TERMS_VERSION=2026-07-22
BOT_API_AUTH_RATE_LIMIT_PER_MINUTE=30
BOT_API_SERVICE_RATE_LIMIT_PER_MINUTE=600
BOT_API_USER_RATE_LIMIT_PER_MINUTE=90
BOT_API_BINDING_RATE_LIMIT_PER_MINUTE=10
BOT_API_BINDING_REVOKE_SERVICE_RATE_LIMIT_PER_MINUTE=120
BOT_API_BINDING_REVOKE_RATE_LIMIT_PER_MINUTE=30
BOT_API_IDEMPOTENCY_TTL_HOURS=72
BOT_API_MAX_BATCH_SIZE=10
BOT_API_MAX_RENTAL_DAYS=366

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=drive_phangan
DB_USERNAME=drive_phangan_app
DB_PASSWORD=
DB_SEARCH_PATH=public
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
