server {
    listen 80;
    listen [::]:80;
    server_name __PREVIEW_HOST__;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    location ^~ /.well-known/acme-challenge/ {
        root /srv/drive-phangan-preview/acme;
        try_files $uri =404;
    }
    location / { return 308 https://__PREVIEW_HOST__$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __PREVIEW_HOST__;
    root /srv/drive-phangan-preview/current/backend/public;
    ssl_certificate /etc/letsencrypt/live/drive-phangan-preview/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/drive-phangan-preview/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    client_max_body_size 64k;
    auth_basic "Drive Phangan private test preview";
    auth_basic_user_file /etc/drive-phangan-preview/htpasswd;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "no-store, private" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    access_log /srv/drive-phangan-preview/shared/logs/nginx-access.log;
    error_log /srv/drive-phangan-preview/shared/logs/nginx-error.log warn;

    location ~ ^/(?:website|build)/[A-Za-z0-9_./-]+\.(?:css|js|woff2?|ttf|webp|png|jpe?g|svg|ico)$ {
        try_files $uri =404;
    }
    location ~ "^/storage/vehicles/([1-9][0-9]*)/([a-f0-9]{64})\.webp$" {
        alias /srv/drive-phangan-preview/shared/storage/app/public/vehicles/$1/$2.webp;
    }
    location ~ "^/website-media/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}/(?:card|card_2x|detail)/[a-f0-9]{64}\.webp$" {
        try_files __no_static_preview_media__ @preview_php;
    }
    location = / { try_files __no_static_preview_root__ @preview_php; }
    location = /robots.txt { try_files __no_static_preview_robots__ @preview_php; }
    location = /sitemap.xml { try_files __no_static_preview_sitemap__ @preview_php; }
    location ~ ^/(?:en|ru|uk)(?:/.*)?$ { try_files __no_static_preview_route__ @preview_php; }
    location @preview_php {
        include fastcgi_params;
        fastcgi_pass unix:/run/drive-phangan-preview/php.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        fastcgi_param REMOTE_USER $remote_user;
        fastcgi_param HTTP_AUTHORIZATION "";
        fastcgi_param HTTP_PROXY "";
        fastcgi_read_timeout 30s;
    }
    location / { return 404; }
}
