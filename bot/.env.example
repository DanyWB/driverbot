# Node.js Telegram client. Never commit real secrets.
NODE_ENV=development
BOT_TOKEN=
BOT_DATA_MODE=laravel

# Laravel Bot API (required in laravel mode)
BOT_API_URL=http://127.0.0.1:8000/api/v1/bot
BOT_API_TOKEN=
BOT_API_TIMEOUT_MS=5000
BOT_API_MAX_ATTEMPTS=3
BOT_CUSTOMER_SYNC_TTL_SECONDS=86400
BOT_FILE_DOWNLOAD_TIMEOUT_MS=15000
BOT_DOCUMENT_MAX_MB=10

# Redis sessions (required in laravel mode)
REDIS_URL=redis://127.0.0.1:6379/1
BOT_SESSION_PREFIX=drive-phangan:bot:session:v1
BOT_SESSION_TTL_SECONDS=2592000
BOT_SESSION_LOCK_TTL_MS=30000
BOT_SESSION_LOCK_WAIT_MS=30000

# PostgreSQL (legacy rollback mode only; remove after cutover)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=driverbot_user
PG_PASSWORD=
PG_DATABASE=driverbot
PG_SSL=false
DATABASE_URL=

# Rental business timezone
BOOKING_TZ=Asia/Bangkok

# Local Redis used by environment checks and the future bot session store
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional Google Sheets legacy synchronization
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SHEET_NAME=Calendar
GOOGLE_SHEETS_DAYS_AHEAD=90
GOOGLE_SHEETS_SYNC_INTERVAL_MINUTES=60
GOOGLE_SHEETS_SERVICE_ACCOUNT_PATH=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Legacy pricing behavior. Laravel will use the rules from PRICING_IMPORT_SPEC.md.
BIKE_PRICE_ROUNDING=floor
BIKE_PRICE_ROUNDING_STEP=100
BIKE_PRICE_ROUNDING_MIN_DAYS=7
