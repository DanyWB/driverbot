[Unit]
Description=Drive Phangan PostgreSQL and persistent files backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=drive-phangan
Group=drive-phangan
WorkingDirectory=/srv/drive-phangan/current
Environment=APP_ROOT=/srv/drive-phangan
Environment=BACKUP_ROOT=/srv/drive-phangan/backups
Environment=BACKUP_RETENTION_DAYS=14
Environment=ENABLE_BACKUP_PRUNE=true
ExecStart=/srv/drive-phangan/current/deploy/scripts/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/drive-phangan/backups /srv/drive-phangan/shared/backend/storage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
