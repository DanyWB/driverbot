{
  "name": "bike-rent-bot",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "knex migrate:latest",
    "check": "npm run preflight",
    "preflight": "node scripts/preflight.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:translations": "node scripts/check-translations.js",
    "check:migrations": "node scripts/check-migrations.js",
    "check:bot-load": "node scripts/check-bot-load.js",
    "check:data": "node scripts/check-data.js",
    "check:data:preflight": "node scripts/check-data.js --allow-content-warnings",
    "check:rental-service": "node scripts/check-rental-service.js",
    "test": "node --test tests/*.test.js",
    "check:laravel-mode": "node scripts/check-laravel-mode.js",
    "check:redis-session": "node scripts/check-redis-session.js",
    "check:api": "node scripts/check-laravel-api.js",
    "test:e2e:api": "node scripts/e2e-laravel-api.js",
    "test:load:api": "node scripts/load-booking-api.js",
    "release:preflight": "node scripts/release-preflight.js",
    "release:smoke": "node scripts/release-preflight.js --online"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "googleapis": "^173.0.0",
    "grammy": "^1.17.0",
    "knex": "^2.5.1",
    "module-alias": "^2.2.3",
    "node-calendar": "^0.1.5",
    "pg": "^8.11.0",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "_moduleAliases": {
    "@": "./src"
  }
}
